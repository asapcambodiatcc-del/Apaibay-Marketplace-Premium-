{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:commerce": "NODE_ENV=test tsx scripts/test-commerce-security.ts",
    "test:phase5a": "NODE_ENV=test tsx scripts/test-phase5a-payments.ts",
    "test:phase5b": "NODE_ENV=test tsx scripts/test-phase5b-payments.ts",
    "test:phase5c": "NODE_ENV=test tsx scripts/test-phase5c-payments.ts",
    "test:phase6": "NODE_ENV=test tsx scripts/test-phase6-staging-verification.ts",
    "test:phase7": "NODE_ENV=test tsx scripts/test-phase7-staging-smoke-test.ts",
    "test:phase7-1": "NODE_ENV=test tsx scripts/test-phase7-1-sandbox-environment.ts",
    "test:phase7-3": "NODE_ENV=test tsx scripts/test-phase7-3-android-deployment.ts",
    "test:phase8-1": "NODE_ENV=test tsx scripts/test-phase8-1-cart-buynow.ts",
    "test:phase11": "NODE_ENV=test tsx scripts/test-phase11-quota-remediation.ts",
    "test:phase12": "NODE_ENV=test tsx scripts/test-phase12-seller-commission.ts",
    "test:responsive": "NODE_ENV=test tsx scripts/test-mobile-responsive.ts",
    "test:auth": "NODE_ENV=test tsx scripts/test-auth-errors-regression.ts",
    "test:all": "npm run test:commerce && npm run test:phase5a && npm run test:phase5b && npm run test:phase5c && npm run test:phase6 && npm run test:phase7 && npm run test:phase7-1 && npm run test:phase7-3 && npm run test:phase8-1 && npm run test:phase11 && npm run test:phase12 && npm run test:responsive && npm run test:auth"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
