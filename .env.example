# ==============================================================================
# Apaibay Marketplace Premium - Safe Environment Template
# NEVER commit real credentials. Placeholders only.
# ==============================================================================

# Core Application Settings
# Explicit deployment target: development | test | staging | production
APP_ENV=development
PAYMENT_ENVIRONMENT=sandbox
APP_URL=http://localhost:3000
# Optional comma-separated staging/production origins allowed by API CORS policy
ALLOWED_ORIGINS=
PAYMENT_DEFAULT_PROVIDER=sandbox
NODE_ENV=development

# Settlement & Payout Policy (Configurable per environment)
# Number of days after delivery confirmation before seller settlement matures to available
SELLER_SETTLEMENT_HOLD_DAYS=7

# Isolated Staging Firebase Targets (REQUIRED when APP_ENV=staging; NEVER fall back to production)
# Leave blank in production/development so firebase-applet-config.json production targets remain intact.
FIREBASE_PROJECT_ID=
FIREBASE_FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=

# Frontend Vite Build Variables for Isolated Staging Builds (REQUIRED when VITE_APP_ENV=staging)
VITE_APP_ENV=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin SDK Credentials (Server-side only; NEVER commit real keys or JSON)
# Option 1 (recommended for Render/containers): Full single-line JSON string of Firebase service account
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2 (local file path or GCP ADC): Path to mounted service account key file
GOOGLE_APPLICATION_CREDENTIALS=

# Security & Identity Signing Secrets
# REQUIRED IN PRODUCTION / STAGING (minimum 32 characters; server fails closed if missing)
# Generate with e.g. 64-character hex string and keep identical across all backend instances
KYC_VIEW_TOKEN_SECRET=

# Gemini AI API Key (Injected by platform runtime)
GEMINI_API_KEY=

# ABA PayWay
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_PAYWAY_CHECK_TXN_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction
ABA_PAYWAY_WEBHOOK_SECRET=

# Bakong / KHQR
BAKONG_KHQR_MERCHANT_ID=
BAKONG_KHQR_API_KEY=
BAKONG_KHQR_MERCHANT_NAME=Apaibay Marketplace
BAKONG_KHQR_API_URL=https://api-bakong-sandbox.nbc.gov.kh
BAKONG_KHQR_WEBHOOK_SECRET=

# Wing Bank
WING_MERCHANT_ID=
WING_API_KEY=
WING_API_URL=https://sandbox.wingmoney.com/api/v1/payment
WING_WEBHOOK_SECRET=

# NOWPayments Cryptocurrency Gateway
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

